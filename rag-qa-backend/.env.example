# =============================================
# RAG-QA Backend 环境变量配置
# =============================================
# 复制此文件为 .env，然后填入实际值：
#   cd rag-qa-backend
#   cp .env.example .env
#
# Spring Boot 通过 dotenv-spring-boot 在应用启动时加载本目录的 .env。

# =============================================
# LLM API 配置
# =============================================
# 【必填】LLM 服务商的 API Key
# 推荐使用 硅基流动 (https://siliconflow.cn) 或 MiniMax (https://api.minimax.chat)
OPENAI_API_KEY=your_api_key_here

# 【必填】LLM API 地址
# 硅基流动: https://api.siliconflow.cn/v1
# MiniMax:  https://api.minimax.chat/v1
OPENAI_BASE_URL=https://api.minimax.chat/v1

# 【必填】使用的模型名称
# 硅基流动可用: Qwen/Qwen2.5-7B-Instruct, deepseek-ai/DeepSeek-V2.5 等
# MiniMax:      MiniMax-M2.5 / MiniMax-M3
OPENAI_MODEL=MiniMax-M3

# =============================================
# 数据库配置 (MySQL)
# =============================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ragqa
DB_USER=root
DB_PASSWORD=root

# =============================================
# Chroma 向量数据库配置
# =============================================
CHROMA_URL=http://localhost:8000
CHROMA_PERSIST_DIR=./chroma-data
CHROMA_COLLECTION=rag-qa-collection

# =============================================
# Ollama Embedding（可选，依赖实际部署）
# =============================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:4b

# =============================================
# 文件存储配置
# =============================================
FILE_UPLOAD_DIR=./uploads

# =============================================
# 文本分块策略
# =============================================
# 可选值: fixed(固定大小) | paragraph(按段落)
CHUNK_STRATEGY=fixed

# =============================================
# 流式输出
# =============================================
# 可选值: true(流式) | false(非流式)
CHAT_STREAMING=true

# =============================================
# Agentic RAG 配置
# =============================================
# 【可选】Tavily Web 搜索 API Key
# Agentic RAG 的 WebSearchTool 使用；未配置则该 tool 不注册，agent 仅用 KB检索/直答
# 获取地址：https://tavily.com（免费 1000 次/月）
TAVILY_API_KEY=

# 全局 RAG 模式默认值；Conversation.rag_mode 可 per-conversation 覆盖
# 可选值: linear | agentic
RAG_MODE=linear

# Agentic 模式超时（毫秒）；超时则降级 linear
RAG_AGENT_TIMEOUT_MS=30000

# Web 搜索 Top-K 与超时（毫秒）
RAG_WEB_TOPK=5
RAG_WEB_TIMEOUT_MS=8000

# =============================================
# JWT 鉴权
# =============================================
# 【必填】至少 32 字节（256 位），生产环境由密钥管理服务注入
JWT_SECRET=replace-me-with-a-secret-of-at-least-32-bytes

# =============================================
# 服务器端口
# =============================================
SERVER_PORT=8080
